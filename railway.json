{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./Dockerfile",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/database/**",
      "/Dockerfile",
      "/.dockerignore",
      "/package.json",
      "/package-lock.json",
      "/tsconfig*.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "sh -c 'npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma && node apps/api/dist/server.js'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthCheckPath": "/health",
    "healthCheckTimeout": 5
  }
}
